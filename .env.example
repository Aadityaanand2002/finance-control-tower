# Copy to backend/.env or project root as needed.
# Defaults enable a full demo with no external credentials.

DEMO_MODE=true
DATABASE_URL=sqlite:///./finance_control_tower.db

# PostgreSQL (Docker Compose) — uses psycopg v3 driver
# DATABASE_URL=postgresql+psycopg://fct:fct_secret@postgres:5432/finance_control_tower

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_USER=Finance Admin

OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=mock

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DATA_PROVIDER=mock
